{
    "name": "ParFlow ShortCourse",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "python -m ipykernel install --user --name subsetting-shortcourse --display-name \"Python (ParFlow ShortCourse)\"",
    "remoteUser": "ubuntu"
}